{
  "name": "dnd-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "dev:vercel": "vercel dev",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:full:prod-env": "node scripts/dev-full.mjs --production",
    "dev:link": "vercel link",
    "dev:session-server": "npm --prefix session-server run dev",
    "deploy:session-server": "npm --prefix session-server run deploy",
    "deploy:session-server-qa": "npm --prefix session-server run deploy:qa",
    "typecheck:session-server": "npm --prefix session-server run typecheck",
    "check:user-workspace-boundaries": "node scripts/check-user-workspace-boundaries.mjs",
    "check:vercel-functions": "node scripts/check-vercel-functions.mjs",
    "build": "npm run check:user-workspace-boundaries && npm run check:vercel-functions && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate": "node scripts/migrate-relational.mjs",
    "spells:fetch": "node scripts/build-spells-json.mjs --force",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.25",
    "@google-cloud/translate": "^9.4.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/blob": "^2.4.1",
    "axios": "^1.19.0",
    "better-auth": "^1.6.25",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vercel": "^59.6.2",
    "vite": "^8.0.4"
  }
}
