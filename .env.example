# Copy this file to `.env.local` for local app / Vercel / Prisma development.
# Never commit real credentials.
#
# `npm run dev:full` starts Vercel + the local Cloudflare session server.
# Vercel-managed variables may override/fill these values when using a linked project.

# =============================================================================
# Database
# =============================================================================

# Primary connection string used by Prisma runtime (`server/prisma.ts`).
# A pooled Neon connection string is appropriate here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Direct/non-pooler connection used by Prisma CLI/migrations (`prisma.config.ts`).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Legacy / relational API aliases.
# The older Neon API code resolves the database in this order:
# POSTGRES_URL -> POSTGRES_PRISMA_URL -> DATABASE_URL.
# Leave blank when DATABASE_URL is the only connection string you need.
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""

# =============================================================================
# Better Auth
# =============================================================================

# Secret used to sign/authenticate Better Auth state.
# Generate a long random value for every environment.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL of the app as seen by Better Auth.
# Local full stack normally runs on port 3000.
BETTER_AUTH_URL="http://localhost:3000"

# =============================================================================
# Vercel Blob
# =============================================================================

# Required by /api/images/upload for character image uploads.
# Usually provisioned by the Vercel Blob integration.
BLOB_READ_WRITE_TOKEN=""

# =============================================================================
# Translation
# =============================================================================

# Optional provider selector: `google` or `libre`.
# If omitted, Google is selected when GOOGLE_TRANSLATE_API_KEY exists;
# otherwise LibreTranslate is used.
TRANSLATE_PROVIDER=""

# Optional LibreTranslate endpoint override.
TRANSLATE_API_URL="https://de.libretranslate.com/translate"

# Optional LibreTranslate API key.
TRANSLATE_API_KEY=""

# Used by the Google translation API and scripts/translate-spells.ts.
GOOGLE_TRANSLATE_API_KEY=""

# =============================================================================
# Session runtime (frontend)
# =============================================================================

# Cloudflare Worker URL used by the React session runtime.
# `npm run dev:full` defaults this to the local Worker.
VITE_SESSION_SERVER_URL="http://localhost:8787"

# Legacy/local authentication bypass. Full-local mode forces this to false so
# Better Auth + Vercel Functions are exercised.
VITE_LOCAL_AUTH_BYPASS="false"

# =============================================================================
# Session server (Cloudflare Worker)
# =============================================================================

# The Worker currently supports only `development` auth, which reads userId,
# role and clientId from the connection query string. Production signed-token
# authentication is intentionally not implemented yet.
#
# Local Wrangler already sets this in session-server/wrangler.jsonc. For a
# different Worker environment, configure the corresponding Worker variable.
SESSION_AUTH_MODE="development"

# =============================================================================
# Local development scripts
# =============================================================================

# Port used by scripts/dev-full.mjs for `vercel dev`.
LOCAL_VERCEL_PORT="3000"

# Safety guard for `npm run dev:full:prod-env`.
# Set to 1 only for an intentional run against production services/data.
ALLOW_PRODUCTION_DATA="0"
