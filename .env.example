# Copy this file to `.env.local` only when you are not using Vercel-managed envs.
# `npm run dev:full` loads the linked Vercel Development environment for functions/database.

# --- Database (used by Vercel Functions / Prisma) ---
# For normal full-local development, configure these in the Vercel Development environment
# so `vercel dev` uses the same remote development/Neon branch from every browser.
POSTGRES_URL="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"
POSTGRES_PRISMA_URL=""
DATABASE_URL=""

# --- Session runtime ---
# `npm run dev:full` injects this automatically; keep this here for standalone `npm run dev`.
VITE_SESSION_SERVER_URL="http://localhost:8787"

# --- Local development controls ---
# Full-local mode forces this to false so Better Auth + Vercel Functions are exercised.
VITE_LOCAL_AUTH_BYPASS="false"

# Optional port override used by scripts/dev-full.mjs.
LOCAL_VERCEL_PORT="3000"

# Safety guard required by `npm run dev:full:prod-env`.
# Do not persist this as 1 unless you intentionally want local code to use production services/data.
ALLOW_PRODUCTION_DATA="0"
