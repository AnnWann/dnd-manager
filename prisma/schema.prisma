generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  characters Character[]
  homebrewSpells HomebrewSpell[] @relation("HomebrewSpellOwner")
  submittedCampaignSpells CampaignHomebrewSpell[] @relation("CampaignSpellSubmitter")
  reviewedCampaignSpells CampaignHomebrewSpell[] @relation("CampaignSpellReviewer")
  grantedCharacterSpells CharacterHomebrewSpell[] @relation("CharacterSpellGranter")

  ownedCampaigns      Campaign[]       @relation("CampaignOwner")
  campaignMemberships CampaignMember[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CharacterVisibility {
  PRIVATE
  PARTY
  MASTER
}

model Character {
  id         String              @id @default(uuid())
  name       String
  data       Json
  visibility CharacterVisibility @default(PRIVATE)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  campaignLinks CampaignCharacter[]
  homebrewSpells CharacterHomebrewSpell[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("character")
}

enum CampaignRole {
  MASTER
  PLAYER
}

enum CampaignMemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

model Campaign {
  id          String  @id @default(uuid())
  name        String
  description String?
  inviteCode  String? @unique

  ownerId String
  owner   User   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members    CampaignMember[]
  characters CampaignCharacter[]
  homebrewSpells CampaignHomebrewSpell[]
  characterSpellGrants CharacterHomebrewSpell[] @relation("CharacterSpellSourceCampaign")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("campaign")
}

model CampaignMember {
  id     String               @id @default(uuid())
  role   CampaignRole         @default(PLAYER)
  status CampaignMemberStatus @default(ACTIVE)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId])
  @@map("campaign_member")
}

model CampaignCharacter {
  id         String              @id @default(uuid())
  visibility CharacterVisibility @default(PARTY)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([campaignId, characterId])
  @@index([campaignId])
  @@index([characterId])
  @@map("campaign_character")
}

enum HomebrewSpellStatus {
  ACTIVE
  ARCHIVED
}

enum CampaignSpellApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model HomebrewSpell {
  id          String              @id @default(uuid())
  index       String              @unique
  name        String
  data        Json
  status      HomebrewSpellStatus @default(ACTIVE)
  revision    Int                 @default(1)

  ownerId String
  owner   User @relation("HomebrewSpellOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  campaignLinks CampaignHomebrewSpell[]
  characterLinks CharacterHomebrewSpell[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([name])
  @@map("homebrew_spell")
}

model CampaignHomebrewSpell {
  id       String                      @id @default(uuid())
  status   CampaignSpellApprovalStatus @default(PENDING)
  note     String?

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  spellId String
  spell   HomebrewSpell @relation(fields: [spellId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User @relation("CampaignSpellSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User? @relation("CampaignSpellReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, spellId])
  @@index([campaignId, status])
  @@index([spellId])
  @@index([submittedById])
  @@map("campaign_homebrew_spell")
}

model CharacterHomebrewSpell {
  id String @id @default(uuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  spellId String
  spell   HomebrewSpell @relation(fields: [spellId], references: [id], onDelete: Cascade)

  grantedById String
  grantedBy   User @relation("CharacterSpellGranter", fields: [grantedById], references: [id], onDelete: Cascade)

  sourceCampaignId String?
  sourceCampaign   Campaign? @relation("CharacterSpellSourceCampaign", fields: [sourceCampaignId], references: [id], onDelete: SetNull)

  grantedAt DateTime @default(now())

  @@unique([characterId, spellId])
  @@index([spellId])
  @@index([grantedById])
  @@index([sourceCampaignId])
  @@map("character_homebrew_spell")
}
