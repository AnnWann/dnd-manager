generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  characters Character[]
  characterDomainUpdates CharacterDomainState[] @relation("CharacterDomainUpdatedBy")
  characterDomainMutations CharacterDomainMutation[] @relation("CharacterDomainMutationActor")
  homebrewSpells HomebrewSpell[] @relation("HomebrewSpellOwner")
  submittedCampaignSpells CampaignHomebrewSpell[] @relation("CampaignSpellSubmitter")
  reviewedCampaignSpells CampaignHomebrewSpell[] @relation("CampaignSpellReviewer")
  grantedCharacterSpells CharacterHomebrewSpell[] @relation("CharacterSpellGranter")

  ownedCampaigns      Campaign[]       @relation("CampaignOwner")
  campaignMemberships CampaignMember[]
  assignedCampaignCharacters CampaignCharacter[] @relation("CampaignCharacterAssignedUser")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CharacterVisibility {
  PRIVATE
  PARTY
  MASTER
}

enum CharacterDataDomain {
  SHEET
  VITALS
  PROFILE
  ABILITIES
  MAGIC
  INVENTORY
  EQUIPMENT
  PROGRESSION
  NOTES
}

model Character {
  id         String              @id @default(uuid())
  name       String
  /// Legacy compatibility snapshot. New writes should target CharacterDomainState.
  data       Json
  visibility CharacterVisibility @default(PRIVATE)
  revision   Int                 @default(1)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  domains CharacterDomainState[]
  domainMutations CharacterDomainMutation[]
  campaignLinks CampaignCharacter[]
  homebrewSpells CharacterHomebrewSpell[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("character")
}

model CharacterDomainState {
  id       String              @id @default(uuid())
  domain   CharacterDataDomain
  data     Json
  revision Int                 @default(1)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  updatedById String?
  updatedBy   User? @relation("CharacterDomainUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([characterId, domain])
  @@index([characterId])
  @@index([updatedById])
  @@map("user_character_domain_state")
}

model CharacterDomainMutation {
  id               String              @id @default(uuid())
  domain           CharacterDataDomain
  previousRevision Int
  revision         Int
  operation        String              @default("replace")
  mutationId       String?
  clientId         String?

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User? @relation("CharacterDomainMutationActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([characterId, domain, mutationId])
  @@index([characterId, createdAt])
  @@index([actorId])
  @@map("user_character_domain_mutation")
}

enum CampaignRole {
  MASTER
  ASSISTANT
  MODERATOR
  PLAYER
}

enum CampaignMemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

model Campaign {
  id               String  @id @default(uuid())
  name             String
  description      String?
  inviteCode       String? @unique
  creationRevision Int     @default(1)

  ownerId String
  owner   User   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members    CampaignMember[]
  characters CampaignCharacter[]
  homebrewSpells CampaignHomebrewSpell[]
  characterSpellGrants CharacterHomebrewSpell[] @relation("CharacterSpellSourceCampaign")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("campaign")
}

model CampaignMember {
  id     String               @id @default(uuid())
  role   CampaignRole         @default(PLAYER)
  status CampaignMemberStatus @default(ACTIVE)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId])
  @@map("campaign_member")
}

model CampaignCharacter {
  id         String              @id @default(uuid())
  visibility CharacterVisibility @default(PARTY)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Session/campaign assignment. This must never change Character.ownerId.
  assignedUserId String?
  assignedUser   User? @relation("CampaignCharacterAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  /// Session-only character configuration authored in Creation.
  configuration Json?

  addedAt DateTime @default(now())

  @@unique([campaignId, characterId])
  @@index([campaignId])
  @@index([characterId])
  @@index([assignedUserId], map: "campaign_character_assignedUserId_idx")
  @@map("campaign_character")
}

enum HomebrewSpellStatus {
  ACTIVE
  ARCHIVED
}

enum CampaignSpellApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model HomebrewSpell {
  id          String              @id @default(uuid())
  index       String              @unique
  name        String
  data        Json
  status      HomebrewSpellStatus @default(ACTIVE)
  revision   Int                 @default(1)

  ownerId String
  owner   User @relation("HomebrewSpellOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  campaignLinks CampaignHomebrewSpell[]
  characterLinks CharacterHomebrewSpell[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([name])
  @@map("homebrew_spell")
}

model CampaignHomebrewSpell {
  id       String                      @id @default(uuid())
  status   CampaignSpellApprovalStatus @default(PENDING)
  note     String?

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  spellId String
  spell   HomebrewSpell @relation(fields: [spellId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User @relation("CampaignSpellSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User? @relation("CampaignSpellReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, spellId])
  @@index([campaignId, status])
  @@index([spellId])
  @@index([submittedById])
  @@map("campaign_homebrew_spell")
}

model CharacterHomebrewSpell {
  id String @id @default(uuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  spellId String
  spell   HomebrewSpell @relation(fields: [spellId], references: [id], onDelete: Cascade)

  grantedById String
  grantedBy   User @relation("CharacterSpellGranter", fields: [grantedById], references: [id], onDelete: Cascade)

  sourceCampaignId String?
  sourceCampaign   Campaign? @relation("CharacterSpellSourceCampaign", fields: [sourceCampaignId], references: [id], onDelete: SetNull)

  grantedAt DateTime @default(now())

  @@unique([characterId, spellId])
  @@index([spellId])
  @@index([grantedById])
  @@index([sourceCampaignId])
  @@map("character_homebrew_spell")
}

model CampaignContentRequest {
  id            String   @id
  campaignId    String
  type          String
  status        String   @default("PENDING")
  title         String
  sourceId      String
  data          Json     @default("{}")
  note          String?
  submittedById String
  reviewedById  String?
  submittedAt   DateTime @default(now())
  reviewedAt    DateTime?
  updatedAt     DateTime @updatedAt

  @@unique([campaignId, type, sourceId], map: "campaign_content_request_campaign_type_source_key")
  @@index([campaignId, status], map: "campaign_content_request_campaign_status_idx")
  @@index([submittedById], map: "campaign_content_request_submitter_idx")
  @@map("campaign_content_request")
}

model CampaignHomebrewAsset {
  id         String   @id
  campaignId String
  type       String
  sourceId   String
  name       String
  data       Json
  addedById  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, type, sourceId], map: "campaign_homebrew_asset_campaign_type_source_key")
  @@index([campaignId, type], map: "campaign_homebrew_asset_campaign_type_idx")
  @@map("campaign_homebrew_asset")
}

model CampaignItemCompendium {
  id          String   @id
  campaignId  String
  templateId  String
  item        Json
  custom      Boolean  @default(false)
  visibility  String   @default("PUBLIC")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, templateId], map: "campaign_item_compendium_campaign_template_key")
  @@index([campaignId, visibility], map: "campaign_item_compendium_campaign_visibility_idx")
  @@index([createdById], map: "campaign_item_compendium_created_by_idx")
  @@map("campaign_item_compendium")
}