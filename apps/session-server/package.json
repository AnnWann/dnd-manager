{
  "name": "@dnd-manager/session-server-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/build-game-core-runtime.mjs",
    "dev": "wrangler dev --var SESSION_AUTH_MODE:development",
    "predeploy": "node ../../scripts/build-game-core-runtime.mjs",
    "deploy": "wrangler deploy --secrets-file ../../.env.session",
    "predeploy:keep-vars": "node ../../scripts/build-game-core-runtime.mjs",
    "deploy:keep-vars": "wrangler deploy --env=\"\" --keep-vars",
    "predeploy:qa": "node ../../scripts/build-game-core-runtime.mjs",
    "deploy:qa": "wrangler deploy --env qa --secrets-file ../../.env.session.qa",
    "generate-types": "wrangler types",
    "typecheck": "npm run generate-types && tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "wrangler": "^4.0.0"
  }
}
